# marathon working files.
.claude/plans/
.claude/briefs/
node_modules

# From go-web-sdk-template (b6ad574): template/.gitignore.
# Secrets are layered configuration and never committed.
secrets*.json

# Build and coverage artifacts.
bin/
*.test
coverage.out
coverage.html

# Local workspace files.
go.work
go.work.sum
tmp/

# The apps' builds (mise run build:app); each dist/ directory's contents, not the directory, so a
# committed file in it can be let back in: the .gitkeep a Go embed of the directory needs to
# compile with no build.
apps/*/dist/*
!apps/*/dist/.gitkeep
